<!-- HTML wrapper: index.html equivalent -->
<div class="control-section">
    <div class="sample-container">
        <div class="default-section">
            <div class="theme-switcher">
                <label for="themeSelect">Choose a theme:</label>
                <select id="themeSelect">
                    <option value="default" selected>Default Theme</option>
                    <option value="theme1">Theme 1 (Dark Purple)</option>
                    <option value="theme2">Theme 2 (Light Gold)</option>
                    <option value="theme3">Theme 3 (Dark Gray)</option>
                </select>
            </div>
            <div id="defaultRTE"></div>
        </div>
    </div>
</div>

<!-- RTE component: clean component line (text-quick-toolbar pattern) -->
<ejs-richtexteditor id="defaultRTE" cssClass="custom" value="@ViewBag.value">
</ejs-richtexteditor>

<!-- Script: index.ts equivalent -->
<script>
    document.getElementById('themeSelect').addEventListener('change', function (e) {
        var defaultRTE = document.getElementById('defaultRTE').ej2_instances[0];
        var theme = e.target.value;

        if (theme === 'default') {
            defaultRTE.cssClass = 'custom';
        } else {
            defaultRTE.cssClass = 'custom ' + theme;
        }

        defaultRTE.dataBind();
    });
</script>
